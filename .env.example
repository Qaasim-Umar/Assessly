NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional ISO-8601 deadline shared by all login maintenance countdowns.
NEXT_PUBLIC_MAINTENANCE_END_AT=2026-08-27T15:53:36.000Z

# Server-only Resend credential for authentication and transactional email.
RESEND_API_KEY=re_your_resend_api_key

# Server-only Cloudflare R2 credentials. Never prefix these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
