SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only Resend credential for authentication and transactional email.
RESEND_API_KEY=re_your_resend_api_key

# Server-only Cloudflare R2 credentials. Never expose these to browser code.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public admission gist images use a separate R2 bucket and scoped credentials.
# R2_ACCOUNT_ID above is shared when both buckets are in the same Cloudflare account.
ADMISSIONS_R2_ACCESS_KEY_ID=
ADMISSIONS_R2_SECRET_ACCESS_KEY=
ADMISSIONS_R2_BUCKET_NAME=assessly-admissions-images
ADMISSIONS_R2_PUBLIC_BASE_URL=https://images.assessly.ng
